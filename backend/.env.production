# =============================================
# CodeArena Backend - Production Environment
# =============================================
# Copy these to Render Dashboard → Environment Variables

# Server
NODE_ENV=production
PORT=5000

# MongoDB Atlas
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/codearena?retryWrites=true&w=majority

# JWT (Generate secure secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=your_64_character_hex_secret_here
JWT_EXPIRE=30d

# CORS - Your Vercel frontend URL
CLIENT_URL=https://your-app.vercel.app

# Optional: Additional allowed origins (comma-separated)
# ALLOWED_ORIGINS=https://www.yourcustomdomain.com

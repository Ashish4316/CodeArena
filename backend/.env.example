# =============================================
# CodeArena Backend - Environment Configuration
# =============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ======================
# Server Configuration
# ======================
NODE_ENV=development
# NODE_ENV=production  # Use this for production deployment
PORT=5000

# ======================
# MongoDB Configuration
# ======================
# LOCAL DEVELOPMENT (default):
MONGODB_URI=mongodb://localhost:27017/codearena

# PRODUCTION (MongoDB Atlas):
# 1. Go to MongoDB Atlas: https://cloud.mongodb.com
# 2. Create a free cluster
# 3. Create a database user (username/password)
# 4. Get connection string from "Connect" → "Connect your application"
# 5. Replace <username>, <password>, and <dbname> below:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/codearena?retryWrites=true&w=majority

# ======================
# JWT Configuration
# ======================
# IMPORTANT: Generate a strong secret for production!
# Use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=30d
JWT_COOKIE_EXPIRE=30

# ======================
# Rate Limiting
# ======================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ======================
# CORS Configuration
# ======================
# Primary frontend URL
CLIENT_URL=http://localhost:5173

# Additional allowed origins (comma-separated, for production)
# ALLOWED_ORIGINS=https://your-app.vercel.app,https://www.yourdomain.com

# ======================
# Production Deployment URLs (examples)
# ======================
# For Render: https://your-backend.onrender.com
# For Railway: https://your-backend.up.railway.app
# For Vercel: https://your-backend.vercel.app

# ======================
# Optional: Firebase Admin (for token verification)
# ======================
# FIREBASE_PROJECT_ID=your_firebase_project_id
# FIREBASE_PRIVATE_KEY="your_firebase_private_key"
# FIREBASE_CLIENT_EMAIL=your_firebase_client_email

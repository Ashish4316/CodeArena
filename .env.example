# =============================================
# CodeArena Frontend - Environment Configuration
# =============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ======================
# Backend API URL
# ======================
# LOCAL DEVELOPMENT:
VITE_API_URL=http://localhost:5000/api

# PRODUCTION (uncomment and update for your deployment):
# For Render: VITE_API_URL=https://your-backend.onrender.com/api
# For Railway: VITE_API_URL=https://your-backend.up.railway.app/api
# For custom domain: VITE_API_URL=https://api.yourdomain.com/api

